+! Limitation: User-defined MPI datatypes created at runtime cannot be fully validated statically.
+
+program limitation03
+
+implicit none
+
+integer, parameter :: MPI_COMM_WORLD = 0
+integer, parameter :: MPI_INTEGER = 1
