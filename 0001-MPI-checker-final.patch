+#pragma once
+#include <string>
+#include <vector>
+
+struct MPICallSite {
+  std::string functionName;
+  int lineNumber;
+  std::string rawCall;
+
+  std::string bufferName;
+  int count;
+  bool isCountDynamic;
+  int argCount;
+  // executionRank:
+  //  -1 = unconditional
+  //   0-7 = inside IF(rank == N)
+  //  -3 = rank-conditioned but exact rank unknown (e.g. rank /= 0)
+  //  -4 = inside ELSE branch of a rank-conditioned IF
+  int executionRank = -1;
+  int ifConstructDepth = 0;
+  std::string rankConditionText = "";
+
+  int ifConstructId = 0;
+  int ifDepth = 0;
+
+  std::string datatype;
+  std::string variableType;
+
+  bool insideSubroutine = false;
+
+  int actualSize;
+  int dimensions;
+  bool isAssumedShape;
+  bool isPotentialWrapper = false;
+
+  bool isContiguous;
+  bool isCollective;
+  int rankConditioned;
+  int loopDepth = 0;
+  bool isInsideLoop = false;
+  bool hasElseCoverage = false;
+
+  int partnerRank;
+  int tag;
+  std::string communicator;
+  std::vector<std::string> derivedFieldTypes;
+
+  bool hasOptionalArgs;
+  bool isDerivedType;
+  bool isBindC;
+  int derivedFieldCount = 0;
+  bool insideDerivedDefinition = false;
+};
