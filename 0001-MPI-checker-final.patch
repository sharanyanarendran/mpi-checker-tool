index 000000000000..a1c7af5911e7
--- /dev/null
+++ b/flang/lib/Semantics/rule-engine.cpp
@@ -0,0 +1,663 @@
+#include "rule-engine.h"
+#include "llvm/Support/raw_ostream.h"
+#include <map>
+#include <tuple>
+
+std::vector<MPIError> RuleEngine::analyze(std::vector<MPICallSite> &calls) {
+
+  std::set<int> constructsWithElse;
+  for (const auto &site : calls) {
+    if (site.executionRank == -4) {
+      constructsWithElse.insert(site.ifConstructId);
+    }
+  }
+
+  for (auto &site : calls) {
+    if (site.executionRank >= 0) {
+      if (constructsWithElse.count(site.ifConstructId)) {
+        site.hasElseCoverage = true;
+      }
+    }
+  }
+
+  for (auto &site : calls) {
+    if (site.executionRank == -3) { 
+      if (constructsWithElse.count(site.ifConstructId)) {
+        site.hasElseCoverage = true;
+      }
+    }
+  }
+
+  std::vector<MPIError> errors;
+
+  // ── Per-call rules ───────────────────────────
+  for (const auto &call : calls) {
+    checkBufferOverflow(call, errors);
+    checkContiguity(call, errors);
+    checkDatatypeMismatch(call, errors);
+    checkOptionalArgs(call, errors);
+    checkDerivedType(call, errors);
+    checkDerivedLayout(call, errors);
+  }
+
+  // ── Cross-call / global rules ───────────────
+  checkSendRecvMismatch(calls, errors);
+  checkCollectiveReachability(calls, errors);
+  checkCollectiveOrdering(calls, errors);
+  checkMixedCollectiveP2P(calls, errors);
+  checkLoopCollective(calls, errors);
+  checkCrossConstructCommunicator(calls, errors);
+  checkInterProceduralCalls(calls, errors);
+
+  return errors;
+}
+// Buffer overflow rule
+void RuleEngine::checkBufferOverflow(
+    const MPICallSite &call, std::vector<MPIError> &errors) {
+
+  if (!call.isCountDynamic && call.actualSize != -1) {
+    if (call.count > call.actualSize) {
+      errors.push_back(
+          {"BufferOverflow", "Count exceeds buffer size", call.lineNumber});
+    }
+  }
+
+  // Dynamic count with known fixed-size buffer
+  if (call.isCountDynamic && call.actualSize != -1 && !call.isAssumedShape) {
+    errors.push_back({"BufferOverflow",
+        "Dynamic count used with fixed-size buffer — potential overflow",
+        call.lineNumber});
+  }
+}
+
+// Non-contiguous buffer rule
+void RuleEngine::checkContiguity(
+    const MPICallSite &call, std::vector<MPIError> &errors) {
+
+  if (!call.isContiguous) {
+    errors.push_back({"NonContiguous", "Non-contiguous array passed to MPI",
+        call.lineNumber});
+  }
+}
+
+// Datatype mismatch rule
+void RuleEngine::checkDatatypeMismatch(
+    const MPICallSite &call, std::vector<MPIError> &errors) {
+
+  if (call.datatype.empty()) {
+    return;
+  }
+  if (call.isPotentialWrapper) {
+    return;
+  }
+
+  if (call.datatype.find("mpi_byte") != std::string::npos) {
+    return;
+  }
+
+  if (call.datatype.find("mpi_type") == std::string::npos &&
+      call.datatype.find("mpi_real") == std::string::npos &&
+      call.datatype.find("mpi_integer") == std::string::npos &&
+      call.datatype.find("mpi_double") == std::string::npos &&
+      call.datatype.find("mpi_complex") == std::string::npos &&
+      call.datatype.find("mpi_character") == std::string::npos &&
+      call.datatype.find("mpi_logical") == std::string::npos &&
+      call.datatype.find("mpi_byte") == std::string::npos &&
+      call.datatype.find("mpi_packed") == std::string::npos) {
+    // Unknown/custom datatype — emit informational warning
+    errors.push_back({"CustomDatatype",
+        "Custom or unrecognized MPI datatype '" + call.datatype +
+            "' — cannot validate type compatibility statically",
+        call.lineNumber});
+    return;
+  }
+
+  if (call.variableType == "real" &&
+      call.datatype.find("mpi_real") == std::string::npos &&
+      call.datatype.find("mpi_double_precision") == std::string::npos) {
+
+    errors.push_back({"DatatypeMismatch",
+        "REAL variable used with incompatible MPI datatype", call.lineNumber});
+  }
+
+  if (call.variableType == "integer" &&
+      call.datatype.find("mpi_integer") == std::string::npos) {
+
+    errors.push_back({"DatatypeMismatch",
+        "INTEGER variable used with incompatible MPI datatype",
+        call.lineNumber});
+  }
+
+  if (call.variableType == "complex" &&
+      call.datatype.find("mpi_complex") == std::string::npos) {
+    errors.push_back({"DatatypeMismatch",
+        "COMPLEX variable used with incompatible MPI datatype",
+        call.lineNumber});
+  }
+  if (call.variableType == "logical" &&
+      call.datatype.find("mpi_logical") == std::string::npos) {
+    errors.push_back({"DatatypeMismatch",
+        "LOGICAL variable used with incompatible MPI datatype",
+        call.lineNumber});
+  }
+}
+
+void RuleEngine::checkOptionalArgs(
+    const MPICallSite &call, std::vector<MPIError> &errors) {
+
+  if (call.functionName == "mpi_recv") {
+
+    if (call.argCount < 6) {
+      errors.push_back({"OptionalArgs", "MPI_Recv missing required arguments",
+          call.lineNumber});
+    }
+
+    if (call.argCount == 6) {
+      errors.push_back({"OptionalArgs",
+          "MPI_Recv missing status argument (optional but recommended)",
+          call.lineNumber});
+    }
+  }
+
+  if (call.functionName == "mpi_send" && call.argCount > 6) {
+    errors.push_back({"OptionalArgs", "MPI_Send has unexpected extra arguments",
+        call.lineNumber});
+  }
+}
+
+// Derived type warning rule
+void RuleEngine::checkDerivedType(
+    const MPICallSite &call, std::vector<MPIError> &errors) {
+
+  if (!call.isDerivedType) {
+    return;
+  }
+
+  if (!call.isBindC) {
+    errors.push_back({"DerivedType",
+        "Derived type without BIND(C) may be incompatible with MPI",
+        call.lineNumber});
+
+    if (call.actualSize > 1) {
+      errors.push_back({"DerivedType",
+          "Array of derived types without BIND(C) has unpredictable "
+          "inter-element padding — use BIND(C) or MPI derived datatype",
+          call.lineNumber});
+    }
+  }
+
+  if (call.isBindC && !call.isCountDynamic && call.actualSize != -1 &&
+      call.count > call.actualSize) {
+    errors.push_back({"DerivedType",
+        "Count exceeds number of derived type elements in buffer",
+        call.lineNumber});
+  }
+}
+
+// Send/Recv mismatch rule
+void RuleEngine::checkSendRecvMismatch(
+    const std::vector<MPICallSite> &calls, std::vector<MPIError> &errors) {
+
+  struct Msg {
+    MPICallSite call;
+    bool isSend;
+  };
+
+  using Key = std::tuple<int, std::string>;
+  std::map<Key, std::vector<Msg>> groups;
+
+  // Build groups
+  for (const auto &call : calls) {
+
+    if (call.insideSubroutine) {
+      continue;
+    }
+
+    if (call.tag == -1) {
+      continue;
+    }
+
+    bool isSend = call.functionName.find("send") != std::string::npos;
+    bool isRecv = call.functionName.find("recv") != std::string::npos;
+
+    if (!isSend && !isRecv) {
+      continue;
+    }
+
+    Key key = {call.tag, call.communicator};
+    groups[key].push_back({call, isSend});
+  }
+
+  // Analyze each group
+  for (const auto &[key, group] : groups) {
+    std::vector<MPICallSite> sends, recvs;
+    for (const auto &msg : group) {
+      if (msg.isSend) {
+        sends.push_back(msg.call);
+      } else {
+        recvs.push_back(msg.call);
+      }
+    }
+    // Standalone send-only or recv-only test.
+    // Don't try to match unless at least one side is rank-conditioned.
+    if (sends.empty() || recvs.empty()) {
+
+      bool anyRankConditioned = false;
+
+      for (const auto &msg : group) {
+        if (msg.call.executionRank != -1) {
+          anyRankConditioned = true;
+          break;
+        }
+      }
+
+      if (!anyRankConditioned) {
+        continue;
+      }
+    }
+
+    if (sends.size() != recvs.size()) {
+
+      int line =
+          !sends.empty() ? sends.front().lineNumber : recvs.front().lineNumber;
+
+      errors.push_back({"SendRecvMismatch",
+          "Number of sends (" + std::to_string(sends.size()) +
+              ") does not match number of receives (" +
+              std::to_string(recvs.size()) + ")",
+          line});
+
+      continue;
+    }
+
+    if (sends.size() > 1 || recvs.size() > 1) {
+      continue;
+    }
+
+    // ── Matched pair ─────────────────────────────────────
+    const auto &sendCall = sends[0];
+    const auto &recvCall = recvs[0];
+
+    // Wildcard source — MPI_ANY_SOURCE
+    if (recvCall.partnerRank == -1) {
+      errors.push_back({"SendRecvMismatch",
+          "MPI_Recv uses MPI_ANY_SOURCE — cannot statically verify sender",
+          recvCall.lineNumber});
+      if (sendCall.datatype != recvCall.datatype) {
+        errors.push_back({"SendRecvMismatch",
+            "Mismatch between send and receive datatypes (wildcard source)",
+            sendCall.lineNumber});
+      }
+      continue;
+    }
+
+    // Count mismatch
+    if (sendCall.count != -1 && recvCall.count != -1 &&
+        sendCall.count != recvCall.count) {
+      errors.push_back({"SendRecvMismatch",
+          "Mismatch between send and receive counts", sendCall.lineNumber});
+    }
+
+    // Datatype mismatch
+    if (sendCall.datatype != recvCall.datatype) {
+      errors.push_back({"SendRecvMismatch",
+          "Mismatch between send and receive datatypes", sendCall.lineNumber});
+    }
+  }
+}
+
+void RuleEngine::checkCollectiveReachability(
+    const std::vector<MPICallSite> &calls, std::vector<MPIError> &errors) {
+
+  std::set<int> flaggedConstructs;
+
+  for (const auto &call : calls) {
+    if (call.executionRank == -3 && call.hasElseCoverage) {
+      continue;
+    }
+
+    // Skip non-collectives
+    if (!call.isCollective) {
+      continue;
+    }
+
+    if (call.executionRank == -1) {
+      continue;
+    }
+
+    if (call.executionRank == -4) {
+      continue;
+    }
+
+    if (call.hasElseCoverage) {
+      continue;
+    }
+    if (flaggedConstructs.count(call.ifConstructId)) {
+      continue;
+    }
+
+    flaggedConstructs.insert(call.ifConstructId);
+
+    errors.push_back({"CollectiveMismatch",
+        "Collective call may not be executed by all ranks", call.lineNumber});
+  }
+}
+
+void RuleEngine::checkCollectiveOrdering(
+    const std::vector<MPICallSite> &calls, std::vector<MPIError> &errors) {
+
+  // Group collectives by IF depth
+  std::map<int, std::vector<const MPICallSite *>> depthGroups;
+
+  for (const auto &call : calls) {
+    if (call.isCollective && call.executionRank != -1) {
+      depthGroups[call.ifConstructId].push_back(&call);
+    }
+  }
+
+  // Process each IF block independently
+  for (const auto &[depth, group] : depthGroups) {
+
+    std::map<int, std::vector<CollectiveCall>> sequences;
+
+    // Build sequences for this depth
+    for (const auto *call : group) {
+      if (call->executionRank == -1) {
+        continue;
+      }
+
+      if (!call->hasElseCoverage) {
+        continue;
+      }
+
+      sequences[call->executionRank].push_back(
+          {call->functionName, call->lineNumber, call->communicator});
+    }
+    if (sequences.size() < 2) {
+      continue;
+    }
+
+    auto refIt = sequences.end();
+
+    for (auto it = sequences.begin(); it != sequences.end(); ++it) {
+      if (it->first >= 0) {
+        refIt = it;
+        break;
+      }
+    }
+
+    // fallback: unconditional
+    if (refIt == sequences.end()) {
+      refIt = sequences.find(-1);
+    }
+
+    // last fallback
+    if (refIt == sequences.end()) {
+      refIt = sequences.begin();
+    }
+
+    const auto &[refRank, base] = *refIt;
+
+    for (const auto &[rank, seq] : sequences) {
+
+      if (rank == refRank || rank == -3) {
+        continue;
+      }
+
+      std::string rankLabel =
+          (rank == -4) ? "else branch" : "rank " + std::to_string(rank);
+
+      std::string refLabel =
+          (refRank == -4) ? "else branch" : "rank " + std::to_string(refRank);
+
+      for (size_t i = 0; i < std::min(seq.size(), base.size()); i++) {
+
+        if (seq[i].functionName != base[i].functionName) {
+          errors.push_back({"CollectiveOrdering",
+              rankLabel + " calls " + seq[i].functionName + " but " + refLabel +
+                  " calls " + base[i].functionName,
+              seq[i].lineNumber});
+        }
+
+        else if (seq[i].communicator != base[i].communicator) {
+          errors.push_back({"CollectiveOrdering",
+              rankLabel + " uses communicator " + seq[i].communicator +
+                  " but " + refLabel + " uses " + base[i].communicator,
+              seq[i].lineNumber});
+        }
+      }
+
+      if (seq.size() != base.size()) {
+        errors.push_back({"CollectiveOrdering",
+            rankLabel + " has " + std::to_string(seq.size()) +
+                " collective(s) but " + refLabel + " has " +
+                std::to_string(base.size()),
+            seq.size() > base.size() ? seq.back().lineNumber
+                                     : base.back().lineNumber});
+      }
+    }
+  }
+}
+
+void RuleEngine::checkDerivedLayout(
+    const MPICallSite &call, std::vector<MPIError> &errors) {
+
+  if (!call.isDerivedType) {
+    return;
+  }
+
+  if (call.datatype.find("mpi_byte") != std::string::npos) {
+    return;
+  }
+
+  for (const auto &fieldType : call.derivedFieldTypes) {
+
+    if (fieldType == "real" &&
+        call.datatype.find("mpi_real") == std::string::npos) {
+
+      errors.push_back(
+          {"DerivedLayout", "Derived type field (REAL) mismatches MPI datatype",
+              call.lineNumber});
+      return;
+    }
+
+    if (fieldType == "integer" &&
+        call.datatype.find("mpi_integer") == std::string::npos) {
+
+      errors.push_back({"DerivedLayout",
+          "Derived type field (INTEGER) mismatches MPI datatype",
+          call.lineNumber});
+      return;
+    }
+
+    if (fieldType == "complex" &&
+        call.datatype.find("mpi_complex") == std::string::npos) {
+      errors.push_back({"DerivedLayout",
+          "Derived type field (COMPLEX) mismatches MPI datatype",
+          call.lineNumber});
+      return;
+    }
+    if (fieldType == "character" &&
+        call.datatype.find("mpi_character") == std::string::npos) {
+      errors.push_back({"DerivedLayout",
+          "Derived type field (CHARACTER) mismatches MPI datatype",
+          call.lineNumber});
+      return;
+    }
+  }
+}
+
+void RuleEngine::checkMixedCollectiveP2P(
+    const std::vector<MPICallSite> &calls, std::vector<MPIError> &errors) {
+
+  std::map<int, std::vector<const MPICallSite *>> constructGroups;
+  for (const auto &call : calls) {
+    if (call.ifConstructId != 0) {
+      constructGroups[call.ifConstructId].push_back(&call);
+    }
+  }
+
+  for (const auto &[id, group] : constructGroups) {
+    std::vector<const MPICallSite *> ifBranch, elseBranch;
+    for (const auto *call : group) {
+      if (call->executionRank >= 0 && call->hasElseCoverage) {
+        ifBranch.push_back(call);
+      } else if (call->executionRank == -4) {
+        elseBranch.push_back(call);
+      }
+    }
+
+    if (ifBranch.empty() || elseBranch.empty()) {
+      continue;
+    }
+
+    bool ifHasCollective = false, ifHasP2P = false;
+    bool elseHasCollective = false, elseHasP2P = false;
+
+    for (const auto *c : ifBranch) {
+      if (c->isCollective) {
+        ifHasCollective = true;
+      } else {
+        ifHasP2P = true;
+      }
+    }
+    for (const auto *c : elseBranch) {
+      if (c->isCollective) {
+        elseHasCollective = true;
+      } else {
+        elseHasP2P = true;
+      }
+    }
+
+    if (ifHasCollective && elseHasP2P && !elseHasCollective) {
+      for (const auto *c : elseBranch) {
+        if (!c->isCollective) {
+          errors.push_back({"MixedCollectiveP2P",
+              "if-branch uses collective but else-branch uses "
+              "point-to-point — potential deadlock",
+              c->lineNumber});
+          break;
+        }
+      }
+    }
+
+    if (elseHasCollective && ifHasP2P && !ifHasCollective) {
+      for (const auto *c : ifBranch) {
+        if (!c->isCollective) {
+          errors.push_back({"MixedCollectiveP2P",
+              "else-branch uses collective but if-branch uses "
+              "point-to-point — potential deadlock",
+              c->lineNumber});
+          break;
+        }
+      }
+    }
+  }
+}
+
+void RuleEngine::checkLoopCollective(
+    const std::vector<MPICallSite> &calls, std::vector<MPIError> &errors) {
+
+  for (const auto &call : calls) {
+
+    if (!call.isCollective)
+      continue;
+
+    if (!call.isInsideLoop)
+      continue;
+
+    if (call.executionRank != -1 && call.executionRank != -4) {
+
+      // Reachability already covers one-sided collectives
+      if (!call.hasElseCoverage)
+        continue;
+
+      errors.push_back({"LoopCollective",
+          "Collective call inside loop with rank condition — "
+          "iteration counts may differ across ranks",
+          call.lineNumber});
+
+    } else if (call.executionRank == -1 && call.loopDepth > 1) {
+
+      errors.push_back({"LoopCollective",
+          "Collective call inside nested loop — ensure all ranks "
+          "execute identical iteration counts",
+          call.lineNumber});
+    }
+  }
+}
+
+void RuleEngine::checkCrossConstructCommunicator(
+    const std::vector<MPICallSite> &calls, std::vector<MPIError> &errors) {
+
+  std::map<std::string, std::map<std::string, int>> funcCommToLine;
+
+  for (const auto &call : calls) {
+    if (!call.isCollective) {
+      continue;
+    }
+
+    if (call.communicator.empty()) {
+      continue;
+    }
+
+    // only rank-specific collectives
+    if (call.executionRank < 0) {
+      continue;
+    }
+
+    // IF/ELSE handled elsewhere
+    if (call.hasElseCoverage) {
+      continue;
+    }
+
+    // optional loop filter
+    if (call.isInsideLoop) {
+      continue;
+    }
+
+    auto &commMap = funcCommToLine[call.functionName];
+
+    // store first occurrence of communicator
+    if (!commMap.count(call.communicator)) {
+      commMap[call.communicator] = call.lineNumber;
+    }
+  }
+
+  // Detect communicator inconsistencies
+  for (const auto &[func, commMap] : funcCommToLine) {
+
+    if (commMap.size() <= 1) {
+      continue;
+    }
+
+    auto it1 = commMap.begin();
+    auto it2 = std::next(it1);
+
+    // Show earlier source location first
+    if (it1->second > it2->second) {
+      std::swap(it1, it2);
+    }
+
+    errors.push_back({"CommunicatorMismatch",
+        "Different ranks call " + func +
+            " on different communicators: " + it1->first + " (line " +
+            std::to_string(it1->second) + ") vs " + it2->first,
+        it2->second});
+  }
+}
+
+void RuleEngine::checkInterProceduralCalls(
+    const std::vector<MPICallSite> &calls, std::vector<MPIError> &errors) {
+
+  for (const auto &call : calls) {
+    if (call.isPotentialWrapper) {
+      errors.push_back({"InterProcedural",
+          "Possible MPI wrapper '" + call.functionName + "' passes buffer '" +
+              call.bufferName +
+              "' — inter-procedural analysis not supported, "
+              "verify MPI usage inside callee",
+          call.lineNumber});
+    }
+  }
+}
