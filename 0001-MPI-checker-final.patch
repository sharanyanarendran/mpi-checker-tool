+#include "mpi-checker.h"
+#include "flang/MPICallSite.h"
+#include "flang/Parser/parse-tree.h"
+#include "flang/Parser/provenance.h"
+#include "flang/Parser/unparse.h"
+#include "llvm/Support/raw_ostream.h"
+#include <algorithm>
+#include <cctype>
+#include <iostream>
+#include <unordered_map>
+#include <unordered_set>
+#include <vector>
+
+using namespace Fortran;
+
+std::string MPICallVisitor::toLower(std::string s) {
+  std::transform(s.begin(), s.end(), s.begin(), ::tolower);
+  return s;
+}
+
+std::string MPICallVisitor::trim(const std::string &s) {
+  size_t start = s.find_first_not_of(" \t\n");
+  size_t end = s.find_last_not_of(" \t\n");
+  return (start == std::string::npos) ? "" : s.substr(start, end - start + 1);
+}
+
+bool MPICallVisitor::Pre(const parser::TypeDeclarationStmt &stmt) {
+  const auto &declTypeSpec = std::get<parser::DeclarationTypeSpec>(stmt.t);
+
+  // ── Derived TYPE(...) ───────────────────────────────────
+  if (const auto *typeSpec =
+          std::get_if<parser::DeclarationTypeSpec::Type>(&declTypeSpec.u)) {
+
+    this->currentDeclType = "derived";
+    // this->insideDerivedDefinition = true;
+
+    if (!this->insideDerivedDefinition) {
+      std::string dtype =
+          toLower(std::get<parser::Name>(typeSpec->v.t).source.ToString());
+
+      this->currentDerivedTypeName = dtype;
+    }
+    // Check attributes for BIND(C)
+    const auto &attrs = std::get<std::list<parser::AttrSpec>>(stmt.t);
+
+    bool hasBindC = false;
+
+    for (const auto &attr : attrs) {
+      if (std::holds_alternative<parser::LanguageBindingSpec>(attr.u)) {
+        hasBindC = true;
+      }
+    }
+
+    if (hasBindC) {
+      this->currentDeclType = "derived_bindc";
+    }
+  }
+
+  // ── CLASS(...) ──────────────────────────────────────────
+  else if (std::get_if<parser::DeclarationTypeSpec::Class>(&declTypeSpec.u)) {
+    this->currentDeclType = "derived";
+
+    this->currentDerivedTypeName = "";
+  }
+
+  // ── Intrinsic types ─────────────────────────────────────
+  else if (const auto *intrinsic =
+               std::get_if<parser::IntrinsicTypeSpec>(&declTypeSpec.u)) {
+
+    if (std::get_if<parser::IntegerTypeSpec>(&intrinsic->u)) {
+      this->currentDeclType = "integer";
+
+    } else if (std::get_if<parser::IntrinsicTypeSpec::Real>(&intrinsic->u) ||
+        std::get_if<parser::IntrinsicTypeSpec::DoublePrecision>(
+            &intrinsic->u)) {
+      this->currentDeclType = "real";
+
+    } else if (std::get_if<parser::IntrinsicTypeSpec::Complex>(&intrinsic->u)) {
+      this->currentDeclType = "complex";
+
+    } else if (std::get_if<parser::IntrinsicTypeSpec::Character>(
+                   &intrinsic->u)) {
+      this->currentDeclType = "character";
+
+    } else if (std::get_if<parser::IntrinsicTypeSpec::Logical>(&intrinsic->u)) {
+      this->currentDeclType = "logical";
+
+    } else {
+      this->currentDeclType = "unknown";
+    }
+
+    //  reset
+    this->currentDerivedTypeName = "";
+  }
+
+  // ── Fallback ────────────────────────────────────────────
+  else {
+    this->currentDeclType = "unknown";
+    this->currentDerivedTypeName = "";
+  }
+
+  return true;
+}
+
+bool MPICallVisitor::isRankCondition(const std::string &cond) {
+  return cond.find("rank") != std::string::npos ||
+      cond.find("myrank") != std::string::npos ||
+      cond.find("my_rank") != std::string::npos ||
+      cond.find("nrank") != std::string::npos;
+}
+
+void MPICallVisitor::Post(const parser::TypeDeclarationStmt &) {
+  this->currentDeclType = "unknown";
+  this->currentDerivedTypeName = ""; // 🔥 REQUIRED
+}
+
+// ── Rank-if tracking ───────────────────────────────────────────────────────
+bool MPICallVisitor::Pre(const parser::IfConstruct &ifNode) {
+  const auto &ifThenStmt =
+      std::get<parser::Statement<parser::IfThenStmt>>(ifNode.t);
+  std::string cond = this->toLower(ifThenStmt.source.ToString());
+  bool isRank = isRankCondition(cond);
+
+  IfConstructState state;
+  state.isRankConditioned = isRank;
+  state.hasElse = false;
+  state.savedRankContext = this->currentRankContext;
+  state.savedConstructId = this->currentIfConstructId;
+  state.conditionText = cond;
+  state.depth = ifConstructStack.size();
+  ifConstructStack.push_back(state);
+
+  if (isRank) {
+    this->currentIfConstructId = ++this->nextIfConstructId;
+    int r = extractRank(cond);
+    if (r != -2) {
+      this->currentRankContext = r;
+    }
+    ++this->rankIfDepth;
+  }
+  return true;
+}
+
+bool MPICallVisitor::Pre(const parser::IfConstruct::ElseBlock &) {
+
+  if (ifConstructStack.empty()) {
+    return true;
+  }
+
+  // check if THIS construct (top of stack) is rank-conditioned
+  if (ifConstructStack.back().isRankConditioned) {
+    ifConstructStack.back().hasElse = true;
+    this->currentRankContext = -4;
+    this->insideElseBlock = true;
+  }
+  // If inner non-rank if — do nothing, preserve outer rank context
+  return true;
+}
+
+bool MPICallVisitor::Pre(const parser::IfConstruct::ElseIfBlock &block) {
+  const auto &stmt = std::get<parser::Statement<parser::ElseIfStmt>>(block.t);
+  std::string cond = this->toLower(stmt.source.ToString());
+
+  if (ifConstructStack.empty()) {
+    return true;
+  }
+
+  // only act if THIS construct is rank-conditioned
+  if (ifConstructStack.back().isRankConditioned) {
+    ifConstructStack.back().hasElse = true;
+    if (isRankCondition(cond)) {
+      int r = extractRank(cond);
+      this->currentRankContext = (r != -2) ? r : -3;
+    } else {
+      this->currentRankContext = -1;
+    }
+
+  }
+  return true;
+}
+
+void MPICallVisitor::Post(const parser::IfConstruct &ifNode) {
+  if (ifConstructStack.empty()) {
+    return;
+  }
+
+  IfConstructState state = ifConstructStack.back();
+  ifConstructStack.pop_back();
+
+  if (state.isRankConditioned) {
+    // Restore construct ID and rank context
+    this->currentIfConstructId = state.savedConstructId;
+    this->currentRankContext = state.savedRankContext;
+    --this->rankIfDepth;
+    this->insideElseBlock = false;
+  }
+  // Non-rank-conditioned ifs: nothing to restore
+}
+
+bool MPICallVisitor::Pre(const parser::DoConstruct &) {
+  ++this->loopDepth;
+  return true;
+}
+
+void MPICallVisitor::Post(const parser::DoConstruct &) { --this->loopDepth; }
+
+int MPICallVisitor::safeParseInt(const std::string &s) {
+  int value = 0;
+  bool started = false;
+  for (char c : s) {
+    if (isspace(c)) {
+      continue;
+    }
+    if (!isdigit(c)) {
+      return -1;
+    }
+    started = true;
+    value = value * 10 + (c - '0');
+  }
+  return started ? value : -1;
+}
+
+// ── MPI call extraction ────────────────────────────────────────────────────
+void MPICallVisitor::Post(const parser::CallStmt &call) {
+
+  MPICallSite site;
+
+  // INITIALIZE ALL FIELDS
+  site.functionName = "";
+  // LINE NUMBER via provenance
+  if (this->allCooked) {
+    parser::CharBlock src = call.source;
+    if (auto range = this->allCooked->GetSourcePositionRange(src)) {
+      site.lineNumber = static_cast<int>(range->first.line);
+    }
+  }
+
+  site.rawCall = "";
+
+  site.bufferName = "";
+  site.count = -1;
+  site.isCountDynamic = false;
+
+  site.datatype = "";
+  site.variableType = "unknown";
+
+  site.insideSubroutine = this->insideSubroutine;
+  site.ifDepth = ifConstructStack.size();
+
+  site.actualSize = -1;
+  site.dimensions = -1;
+  site.isAssumedShape = false;
+
+  site.isContiguous = true;
+  site.isCollective = false;
+
+  site.partnerRank = -1;
+  site.tag = -1;
+  site.communicator = "";
+
+  site.hasOptionalArgs = false;
+  site.isDerivedType = false;
+  site.isBindC = false;
+
+  site.isPotentialWrapper = false;
+  site.ifConstructId = this->currentIfConstructId;
+
+  site.loopDepth = this->loopDepth;
+  site.isInsideLoop = (this->loopDepth > 0);
+
+  const parser::Call &callInfo = std::get<parser::Call>(call.t);
+  const parser::ProcedureDesignator &proc =
+      std::get<parser::ProcedureDesignator>(callInfo.t);
+
+  //  FUNCTION NAME
+  if (const auto *name = std::get_if<parser::Name>(&proc.u)) {
+    site.functionName = this->toLower(name->source.ToString());
+  }
+
+  // Inter-procedural wrapper detection
+  if (site.functionName.rfind("mpi_", 0) != 0) {
+    const auto &args = std::get<std::list<parser::ActualArgSpec>>(callInfo.t);
+    for (const auto &arg : args) {
+      const auto &actualArg = std::get<parser::ActualArg>(arg.t);
+      if (const auto *exprInd =
+              std::get_if<common::Indirection<parser::Expr>>(&actualArg.u)) {
+        std::string argName =
+            this->toLower(this->trim(exprInd->value().source.ToString()));
+        // If this variable is a known MPI buffer, flag the wrapper
+        if (this->arraySizes.count(argName) ||
+            this->variableTypes.count(argName)) {
+          // Record as potential wrapper — store in a separate list
+          // so rule-engine can report it
+          MPICallSite wrapper;
+          wrapper.functionName = site.functionName;
+          wrapper.lineNumber = site.lineNumber;
+          wrapper.bufferName = argName;
+          wrapper.variableType = this->variableTypes.count(argName)
+              ? this->variableTypes[argName]
+              : "unknown";
+          wrapper.isPotentialWrapper = true;
+          wrapper.rawCall = "";
+          wrapper.count = -1;
+          wrapper.isCountDynamic = false;
+          wrapper.datatype = "";
+          wrapper.actualSize = -1;
+          wrapper.dimensions = -1;
+          wrapper.isAssumedShape = false;
+          wrapper.isContiguous = true;
+          wrapper.isCollective = false;
+          wrapper.partnerRank = -1;
+          wrapper.tag = -1;
+          wrapper.communicator = "";
+          wrapper.hasOptionalArgs = false;
+          wrapper.isDerivedType = false;
+          wrapper.isBindC = false;
+          wrapper.derivedFieldCount = 0;
+          wrapper.executionRank = -1;
+          wrapper.hasElseCoverage = false;
+          wrapper.ifConstructId = 0;
+          wrapper.loopDepth = 0;
+          wrapper.isInsideLoop = false;
+          wrapper.rankConditionText = "";
+          this->calls.push_back(wrapper);
+          break; // only report once per call site
+        }
+      }
+    }
+    return; // still return — not an MPI call
+  }
+
+  static const std::unordered_set<std::string> noBufferCalls = {"mpi_init",
+      "mpi_finalize", "mpi_comm_rank", "mpi_comm_size", "mpi_comm_dup",
+      "mpi_comm_split", "mpi_comm_free", "mpi_type_commit", "mpi_type_free",
+      "mpi_wtime", "mpi_wtick"};
+
+  static const std::unordered_set<std::string> typeCreateCalls = {
+      "mpi_type_create_struct", "mpi_type_vector", "mpi_type_contiguous",
+      "mpi_type_indexed", "mpi_type_create_subarray",
+      "mpi_type_create_hvector"};
+
+  if (typeCreateCalls.count(site.functionName)) {
+    this->customMPITypes.insert(
+        "custom_type_line_" + std::to_string(site.lineNumber));
+    return;
+  }
+
+  if (noBufferCalls.count(site.functionName)) {
+    return;
+  }
+
+  //  RAW CALL
+
+  site.rawCall = call.source.ToString();
+  //  ARGUMENT PARSING
+  const auto &args = std::get<std::list<parser::ActualArgSpec>>(callInfo.t);
+
+  int index = 0;
+  for (const auto &arg : args) {
+    const auto &actualArg = std::get<parser::ActualArg>(arg.t);
+
+    if (const auto *exprInd =
+            std::get_if<common::Indirection<parser::Expr>>(&actualArg.u)) {
+
+      const parser::Expr &realExpr = exprInd->value();
+      std::string cleaned = this->trim(realExpr.source.ToString());
+
+      if (index == 0) {
+        site.bufferName = cleaned;
+        if (site.bufferName.find(":") != std::string::npos) {
+          site.isContiguous = false;
+        }
+        // For barrier, index 0 is the communicator, not a buffer
+        if (site.functionName == "mpi_barrier") {
+          site.communicator = this->toLower(cleaned);
+        }
+
+      } else if (index == 1) {
+        if (site.functionName != "mpi_barrier") {
+          int val = this->safeParseInt(cleaned);
+          if (val == -1) {
+            site.isCountDynamic = true;
+            site.count = -1;
+          } else {
+            site.count = val;
+          }
+        }
+
+      } else if (index == 2) {
+        if (site.functionName != "mpi_barrier") {
+          site.datatype = this->toLower(cleaned);
+        }
+
+      } else if (index == 3) {
+        if (site.functionName != "mpi_barrier") {
+          int val = this->safeParseInt(cleaned);
+          site.partnerRank = val;
+        }
+      } else if (index == 4) {
+        if (site.functionName == "mpi_bcast" ||
+            site.functionName == "mpi_scatter" ||
+            site.functionName == "mpi_gather" ||
+            site.functionName == "mpi_reduce" ||
+            site.functionName == "mpi_allreduce" ||
+            site.functionName == "mpi_allgather" ||
+            site.functionName == "mpi_alltoall") {
+          site.communicator = this->toLower(cleaned);
+        } else {
+          int val = this->safeParseInt(cleaned);
+          site.tag = val;
+        }
+
+      } else if (index == 5) {
+        if (site.functionName == "mpi_send" ||
+            site.functionName == "mpi_recv" ||
+            site.functionName == "mpi_isend" ||
+            site.functionName == "mpi_irecv") {
+          site.communicator = this->toLower(cleaned);
+        }
+      }
+    }
+
+    index++;
+  }
+  site.argCount = index;
+
+  site.hasOptionalArgs = false;
+
+  if (site.functionName == "mpi_recv" || site.functionName == "mpi_irecv") {
+    if (site.argCount >= 7) {
+      site.hasOptionalArgs = true;
+    }
+
+  } else if (site.functionName == "mpi_send" ||
+      site.functionName == "mpi_isend") {
+    if (site.argCount > 6) {
+      site.hasOptionalArgs = true;
+    }
+  }
+
+  // SYMBOL TABLE LOOKUP
+  std::string lookupName = site.bufferName;
+
+  size_t pos = lookupName.find("(");
+  if (pos != std::string::npos) {
+    lookupName = lookupName.substr(0, pos);
+  }
+
+  // normalize
+  lookupName.erase(std::remove_if(lookupName.begin(), lookupName.end(),
+                       [](char c) { return std::isspace(c) || c == ','; }),
+      lookupName.end());
+  lookupName = this->toLower(this->trim(lookupName));
+
+  /* ---------------- DERIVED TYPE ---------------- */
+  if (this->variableToDerivedType.count(lookupName)) {
+
+    std::string dtype = this->variableToDerivedType[lookupName];
+
+    site.isDerivedType = true;
+    site.variableType = "derived";
+
+    if (this->derivedTypeFieldCount.count(dtype)) {
+      site.derivedFieldCount = this->derivedTypeFieldCount[dtype];
+    }
+
+    if (this->derivedTypeFieldTypes.count(dtype)) {
+      site.derivedFieldTypes = this->derivedTypeFieldTypes[dtype];
+    }
+
+    if (this->derivedTypeIsBindC.count(dtype)) {
+      site.isBindC = this->derivedTypeIsBindC[dtype];
+    }
+  }
+
+  /* ---------------- INTRINSIC TYPE ---------------- */
+  else if (this->variableTypes.count(lookupName)) {
+    site.variableType = this->variableTypes[lookupName];
+  }
+
+  /* ---------------- ARRAY INFO ---------------- */
+  if (this->arraySizes.count(lookupName)) {
+    site.actualSize = this->arraySizes[lookupName];
+    site.dimensions = this->dimensions[lookupName];
+    site.isAssumedShape = this->assumedShape[lookupName];
+  }
+
+  // COLLECTIVE DETECTION
+  if (site.functionName == "mpi_bcast" || site.functionName == "mpi_reduce" ||
+      site.functionName == "mpi_allreduce" ||
+      site.functionName == "mpi_barrier" ||
+      site.functionName == "mpi_scatter" || site.functionName == "mpi_gather" ||
+      site.functionName == "mpi_allgather" ||
+      site.functionName == "mpi_alltoall") {
+    site.isCollective = true;
+  }
+
+  // RANK CONDITION
+  site.executionRank = this->currentRankContext;
+
+  bool hasElse = false;
+
+  for (const auto &s : ifConstructStack) {
+    if (s.isRankConditioned && s.hasElse) {
+      hasElse = true;
+      break;
+    }
+  }
+
+  site.hasElseCoverage = this->insideElseBlock || hasElse;
+
+  site.rankConditionText = "";
+  for (int i = static_cast<int>(ifConstructStack.size()) - 1; i >= 0; i--) {
+    if (ifConstructStack[i].isRankConditioned) {
+      site.rankConditionText = ifConstructStack[i].conditionText;
+      break;
+    }
+  }
+
+  this->calls.push_back(site);
+}
+
+// ── Variable declaration extraction ───────────────────────────────────────
+void MPICallVisitor::Post(const parser::EntityDecl &decl) {
+  const auto &objName = std::get<parser::ObjectName>(decl.t);
+  std::string name = this->toLower(this->trim(objName.source.ToString()));
+
+  // Defaults
+  this->dimensions[name] = 1;
+  this->arraySizes[name] = -1;
+  this->assumedShape[name] = false;
+
+  if (this->insideDerivedDefinition) {
+    if (!this->currentDerivedTypeName.empty()) {
+      this->variableToDerivedType[name] = this->currentDerivedTypeName;
+    }
+  } else {
+    this->variableTypes[name] = this->currentDeclType;
+
+    if ((this->currentDeclType == "derived" ||
+            this->currentDeclType == "derived_bindc") &&
+        !this->currentDerivedTypeName.empty()) {
+      this->variableToDerivedType[name] = this->currentDerivedTypeName;
+    }
+  }
+
+  const auto &maybeArraySpec =
+      std::get<std::optional<parser::ArraySpec>>(decl.t);
+  if (maybeArraySpec) {
+    const parser::ArraySpec &spec = *maybeArraySpec;
+
+    if (const auto *explicitList =
+            std::get_if<std::list<parser::ExplicitShapeSpec>>(&spec.u)) {
+      this->dimensions[name] = static_cast<int>(explicitList->size());
+      this->assumedShape[name] = false;
+
+      if (explicitList->size() == 1) {
+        const parser::ExplicitShapeSpec &ess = explicitList->front();
+        const parser::SpecificationExpr &upper =
+            std::get<parser::SpecificationExpr>(ess.t);
+        const parser::Expr &expr = upper.v.thing.thing.value();
+        std::string upperStr = this->trim(expr.source.ToString());
+
+        if (upperStr.find("n") != std::string::npos ||
+            upperStr.find("N") != std::string::npos) {
+          this->arraySizes[name] = -1;
+        } else {
+          this->arraySizes[name] = this->safeParseInt(upperStr);
+        }
+      } else {
+        this->arraySizes[name] = -1;
+      }
+
+    } else if (std::get_if<std::list<parser::AssumedShapeSpec>>(&spec.u)) {
+      this->assumedShape[name] = true;
+      this->arraySizes[name] = -1;
+      const auto &asList =
+          std::get<std::list<parser::AssumedShapeSpec>>(spec.u);
+      this->dimensions[name] = static_cast<int>(asList.size());
+
+    } else if (std::get_if<parser::AssumedSizeSpec>(&spec.u)) {
+      this->assumedShape[name] = true;
+      this->arraySizes[name] = -1;
+      this->dimensions[name] = 1;
+    }
+  }
+}
+
+bool MPICallVisitor::Pre(const parser::SubroutineSubprogram &) {
+
+  insideSubroutine = true;
+  return true;
+}
+
+void MPICallVisitor::Post(const parser::SubroutineSubprogram &) {
+
+  insideSubroutine = false;
+}
+
+bool MPICallVisitor::Pre(const Fortran::parser::DerivedTypeDef &def) {
+  const auto &stmt =
+      std::get<parser::Statement<parser::DerivedTypeStmt>>(def.t);
+
+  const auto &derivedStmt = stmt.statement;
+
+  // 🔥 SAFE: Name is ALWAYS the first element in this node
+  const auto &name = std::get<parser::Name>(derivedStmt.t);
+
+  this->currentDerivedTypeName = toLower(name.source.ToString());
+  this->insideDerivedDefinition = true;
+
+  // Initialize bind(C)
+  this->derivedTypeIsBindC[this->currentDerivedTypeName] = false;
+
+  // Attributes
+  const auto &attrs = std::get<std::list<parser::TypeAttrSpec>>(derivedStmt.t);
+
+  for (const auto &attr : attrs) {
+    if (std::holds_alternative<parser::TypeAttrSpec::BindC>(attr.u)) {
+      this->derivedTypeIsBindC[this->currentDerivedTypeName] = true;
+      break;
+    }
+  }
+
+  const auto &components =
+      std::get<std::list<parser::Statement<parser::ComponentDefStmt>>>(def.t);
+
+  for (const auto &compStmt : components) {
+
+    const auto &compDef = compStmt.statement;
+
+    if (const auto *dataComp =
+            std::get_if<parser::DataComponentDefStmt>(&compDef.u)) {
+
+      const auto &typeSpec = std::get<parser::DeclarationTypeSpec>(dataComp->t);
+
+      std::string fieldType = "unknown";
+      if (const auto *intr =
+              std::get_if<parser::IntrinsicTypeSpec>(&typeSpec.u)) {
+        if (std::get_if<parser::IntegerTypeSpec>(&intr->u)) {
+          fieldType = "integer";
+        } else if (std::get_if<parser::IntrinsicTypeSpec::Real>(&intr->u) ||
+            std::get_if<parser::IntrinsicTypeSpec::DoublePrecision>(&intr->u)) {
+          fieldType = "real";
+        } else if (std::get_if<parser::IntrinsicTypeSpec::Complex>(&intr->u)) {
+          fieldType = "complex";
+        } else if (std::get_if<parser::IntrinsicTypeSpec::Character>(
+                       &intr->u)) {
+          fieldType = "character";
+        } else if (std::get_if<parser::IntrinsicTypeSpec::Logical>(&intr->u)) {
+          fieldType = "logical";
+        }
+      }
+
+      if (fieldType != "unknown") {
+        // Count each declared component in this statement
+        const auto &compList =
+            std::get<std::list<parser::ComponentOrFill>>(dataComp->t);
+        for (const auto &comp : compList) {
+          // Only count real component declarations, not fill (padding) entries
+          if (std::get_if<parser::ComponentDecl>(&comp.u)) {
+            this->derivedTypeFieldCount[this->currentDerivedTypeName]++;
+            this->derivedTypeFieldTypes[this->currentDerivedTypeName].push_back(
+                fieldType);
+          }
+        }
+      }
+    }
+  }
+
+  return true;
+}
+
+void MPICallVisitor::Post(const parser::DerivedTypeDef &) {
+  this->insideDerivedDefinition = false;
+  this->currentDerivedTypeName = "";
+}
+
+// ── JSON output ───────────────────────────────────────────────────────────
+void MPICallVisitor::PrintJSON() {
+  std::cout << "[\n";
+  for (size_t i = 0; i < calls.size(); i++) {
+    const auto &c = this->calls[i];
+
+    std::cout << "  {\n";
+    std::cout << "    \"functionName\": \"" << c.functionName << "\",\n";
+    std::cout << "    \"lineNumber\": " << c.lineNumber << ",\n";
+    std::cout << "    \"rawCall\": \"" << c.rawCall << "\",\n";
+    std::cout << "    \"bufferName\": \"" << c.bufferName << "\",\n";
+    std::cout << "    \"count\": " << c.count << ",\n";
+    std::cout << "    \"isCountDynamic\": "
+              << (c.isCountDynamic ? "true" : "false") << ",\n";
+    std::cout << "    \"datatype\": \"" << c.datatype << "\",\n";
+    std::cout << "    \"variableType\": \"" << c.variableType << "\",\n";
+    std::cout << "    \"actualSize\": " << c.actualSize << ",\n";
+    std::cout << "    \"dimensions\": " << c.dimensions << ",\n";
+    std::cout << "    \"isAssumedShape\": "
+              << (c.isAssumedShape ? "true" : "false") << ",\n";
+    std::cout << "    \"isContiguous\": " << (c.isContiguous ? "true" : "false")
+              << ",\n";
+    std::cout << "    \"isCollective\": " << (c.isCollective ? "true" : "false")
+              << ",\n";
+    std::cout << "    \"partnerRank\": " << c.partnerRank << ",\n";
+    std::cout << "    \"tag\": " << c.tag << ",\n";
+    std::cout << "    \"communicator\": \"" << c.communicator << "\",\n";
+    std::cout << "    \"hasOptionalArgs\": "
+              << (c.hasOptionalArgs ? "true" : "false") << ",\n";
+    std::cout << "    \"isDerivedType\": "
+              << (c.isDerivedType ? "true" : "false") << ",\n";
+    std::cout << "    \"derivedFieldCount\": " << c.derivedFieldCount << ",\n";
+    std::cout << "    \"isBindC\": " << (c.isBindC ? "true" : "false") << ",\n";
+    std::cout << "    \"isPotentialWrapper\": "
+              << (c.isPotentialWrapper ? "true" : "false") << ",\n";
+    std::cout << "    \"isInsideLoop\": " << (c.isInsideLoop ? "true" : "false")
+              << ",\n";
+    std::cout << "    \"rankConditionText\": \"" << c.rankConditionText
+              << "\"\n";
+    std::cout << "  }";
+    if (i != this->calls.size() - 1) {
+      std::cout << ",";
+    }
+    std::cout << "\n";
+  }
+  std::cout << "]\n";
+}
+
+int MPICallVisitor::extractRank(const std::string &cond) {
+  if (cond.find(".or.") != std::string::npos ||
+      cond.find(".and.") != std::string::npos) {
+    return -3;
+  }
+
+  for (int i = 0; i < 64; i++) {
+    std::string val = std::to_string(i);
+    if (cond.find("== " + val) != std::string::npos ||
+        cond.find("==" + val) != std::string::npos ||
+        cond.find(".eq." + val) != std::string::npos) {
+      return i;
+    }
+  }
+
+  // Inequality conditions
+  if (cond.find("/=") != std::string::npos ||
+      cond.find(".ne.") != std::string::npos ||
+      cond.find(">") != std::string::npos ||
+      cond.find("<") != std::string::npos) {
+    return -3;
+  }
+
+  return -2; // not rank-conditioned
+}
+
+std::string MPICallVisitor::extractFullCall(int lineNumber) {
+  if (!fileLines || lineNumber <= 0 ||
+      lineNumber > static_cast<int>(fileLines->size())) {
+    return "";
+  }
+
+  std::string result;
+  int openParens = 0;
+  bool started = false;
+
+  for (int i = lineNumber - 1; i < static_cast<int>(fileLines->size()); i++) {
+    std::string line = (*fileLines)[i];
+
+    line.erase(std::remove(line.begin(), line.end(), '&'), line.end());
+
+    line = this->trim(line);
+
+    if (!result.empty()) {
+      result += " ";
+    }
+    result += line;
+
+    for (char c : line) {
+      if (c == '(') {
+        openParens++;
+        started = true;
+      } else if (c == ')') {
+        openParens--;
+      }
+    }
+
+    if (started && openParens == 0) {
+      break;
+    }
+  }
+  result = this->trim(result);
+
+  return result;
+}
