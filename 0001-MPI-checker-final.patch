+  void checkDerivedType(const MPICallSite &call, std::vector<MPIError> &errors);
+
+  void checkSendRecvMismatch(
+      const std::vector<MPICallSite> &calls, std::vector<MPIError> &errors);
+
+  void checkCollectiveReachability(
+      const std::vector<MPICallSite> &calls, std::vector<MPIError> &errors);
+
+  void checkCollectiveOrdering(
+      const std::vector<MPICallSite> &calls, std::vector<MPIError> &errors);
+
+  void checkDerivedLayout(
+      const MPICallSite &call, std::vector<MPIError> &errors);
+
+  void checkMixedCollectiveP2P(
+      const std::vector<MPICallSite> &calls, std::vector<MPIError> &errors);
+
+  void checkLoopCollective(
+      const std::vector<MPICallSite> &calls, std::vector<MPIError> &errors);
+
+  void checkCrossConstructCommunicator(
+      const std::vector<MPICallSite> &calls, std::vector<MPIError> &errors);
+
+  void checkInterProceduralCalls(
+      const std::vector<MPICallSite> &calls, std::vector<MPIError> &errors);
+};
