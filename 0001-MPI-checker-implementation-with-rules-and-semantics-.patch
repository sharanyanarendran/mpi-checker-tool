diff --git a/flang/include/flang/MPICallSite.h b/flang/include/flang/MPICallSite.h
new file mode 100644
index 000000000000..736aed080f8b
--- /dev/null
+++ b/flang/include/flang/MPICallSite.h
@@ -0,0 +1,43 @@
+#pragma once
+#include <string>
+
+struct MPICallSite {
+  std::string functionName;
+  int lineNumber;
+  std::string rawCall;
+
+  std::string bufferName;
+  int count;
+  bool isCountDynamic;
+  int argCount;
+  // executionRank:
+  //   -1  = unconditional (not inside any rank-if)
+  //   0-7 = inside IF (rank == N)
+  //   -3  = inside rank-conditioned branch but exact rank unknown (e.g. rank /=
+  //   0)
+  int executionRank = -1;
+
+  std::string datatype;
+  std::string variableType;
+
+  int actualSize;
+  int dimensions;
+  bool isAssumedShape;
+
+  bool isContiguous;
+  bool isCollective;
+  int rankConditioned;
+
+  bool hasElseCoverage = false;
+
+  int partnerRank; // arg index 3 for send/recv
+  int tag; // arg index 4
+  std::string communicator; // arg index 5
+  std::vector<std::string> derivedFieldTypes;
+
+  bool hasOptionalArgs;
+  bool isDerivedType;
+  bool isBindC;
+  int derivedFieldCount = 0;
+  bool insideDerivedDefinition = false;
+};
\ No newline at end of file
