+#include "rule-engine.h"
+#include "llvm/Support/raw_ostream.h"
+#include <map>
+#include <tuple>
+
+// ─────────────────────────────────────────────────────────────
+// Main entry
+// ─────────────────────────────────────────────────────────────
+std::vector<MPIError> RuleEngine::analyze(
+    const std::vector<MPICallSite> &calls) {
+
+  std::vector<MPIError> errors;
+
+  // ── Per-call rules ───────────────────────────
+  for (const auto &call : calls) {
+    checkBufferOverflow(call, errors);
+    checkContiguity(call, errors);
+    checkDatatypeMismatch(call, errors);
+    // checkCollectiveMisuse(call, errors);
+    checkOptionalArgs(call, errors);
+    checkDerivedType(call, errors);
+    checkDerivedLayout(call, errors); // ✅ fixed
+  }
+
+  // ── Cross-call / global rules ───────────────
+  checkSendRecvMismatch(calls, errors);
+  checkCollectiveReachability(calls, errors);
+  checkCollectiveOrdering(calls, errors);
+
+  return errors;
+}
+// ─────────────────────────────────────────────────────────────
+// RULE 1: Buffer overflow
+// ─────────────────────────────────────────────────────────────
+void RuleEngine::checkBufferOverflow(
+    const MPICallSite &call, std::vector<MPIError> &errors) {
+
+  if (!call.isCountDynamic && call.actualSize != -1) {
+    if (call.count > call.actualSize) {
+      errors.push_back(
+          {"BufferOverflow", "Count exceeds buffer size", call.lineNumber});
+    }
+  }
+}
+
+// ─────────────────────────────────────────────────────────────
+// RULE 2: Non-contiguous buffer
+// ─────────────────────────────────────────────────────────────
+void RuleEngine::checkContiguity(
+    const MPICallSite &call, std::vector<MPIError> &errors) {
+
+  if (!call.isContiguous) {
+    errors.push_back({"NonContiguous", "Non-contiguous array passed to MPI",
+        call.lineNumber});
+  }
+}
+
+// ─────────────────────────────────────────────────────────────
+// RULE 3: Datatype mismatch
+// ─────────────────────────────────────────────────────────────
+void RuleEngine::checkDatatypeMismatch(
+    const MPICallSite &call, std::vector<MPIError> &errors) {
+
+  if (call.datatype.empty()) {
+    return;
+  }
+
+  if (call.variableType == "real" &&
+      call.datatype.find("mpi_real") == std::string::npos &&
+      call.datatype.find("mpi_double_precision") == std::string::npos) {
+
+    errors.push_back({"DatatypeMismatch",
+        "REAL variable used with incompatible MPI datatype", call.lineNumber});
+  }
+
+  if (call.variableType == "integer" &&
+      call.datatype.find("mpi_integer") == std::string::npos) {
+
+    errors.push_back({"DatatypeMismatch",
+        "INTEGER variable used with incompatible MPI datatype",
+        call.lineNumber});
+  }
+
+  if (call.variableType == "complex" &&
+      call.datatype.find("mpi_complex") == std::string::npos) {
+    errors.push_back({"DatatypeMismatch",
+        "COMPLEX variable used with incompatible MPI datatype",
+        call.lineNumber});
+  }
+  if (call.variableType == "logical" &&
+      call.datatype.find("mpi_logical") == std::string::npos) {
+    errors.push_back({"DatatypeMismatch",
+        "LOGICAL variable used with incompatible MPI datatype",
+        call.lineNumber});
+  }
+}
+
+// ─────────────────────────────────────────────────────────────
+// RULE 4: Collective misuse
+// ─────────────────────────────────────────────────────────────
+
+// void RuleEngine::checkCollectiveMisuse(
+//     const MPICallSite &call, std::vector<MPIError> &errors) {
+
+//   if (call.isCollective && call.executionRank != -1) {
+//     errors.push_back({"CollectiveMismatch",
+//         "Collective call inside rank-dependent condition", call.lineNumber});
+//   }
+// }
+
+// ─────────────────────────────────────────────────────────────
+// RULE 5: Optional arguments warning
+// ─────────────────────────────────────────────────────────────
+void RuleEngine::checkOptionalArgs(
+    const MPICallSite &call, std::vector<MPIError> &errors) {
+
+  // MPI_Recv expects at least 7 args (status optional but important)
+  if (call.functionName == "mpi_recv") {
+
+    if (call.argCount < 6) {
+      errors.push_back({"OptionalArgs", "MPI_Recv missing required arguments",
+          call.lineNumber});
+    }
+
+    if (call.argCount == 6) {
+      errors.push_back({"OptionalArgs",
+          "MPI_Recv missing status argument (optional but recommended)",
+          call.lineNumber});
+    }
+  }
+
+  // MPI_Send should NOT have extra args
+  if (call.functionName == "mpi_send" && call.argCount > 6) {
+    errors.push_back({"OptionalArgs", "MPI_Send has unexpected extra arguments",
+        call.lineNumber});
+  }
+}
+
+// ─────────────────────────────────────────────────────────────
+// RULE 6: Derived type warning
+// ─────────────────────────────────────────────────────────────
+void RuleEngine::checkDerivedType(
+    const MPICallSite &call, std::vector<MPIError> &errors) {
+
+  if (call.isDerivedType && !call.isBindC) {
+    errors.push_back({"DerivedType",
+        "Derived type without BIND(C) may be incompatible with MPI",
+        call.lineNumber});
+  }
+}
+
+// ─────────────────────────────────────────────────────────────
+// RULE 7: Send/Recv mismatch (cross-call)
+// ─────────────────────────────────────────────────────────────
+void RuleEngine::checkSendRecvMismatch(
+    const std::vector<MPICallSite> &calls, std::vector<MPIError> &errors) {
+
+  struct Msg {
+    MPICallSite call;
+    bool isSend;
+  };
+
+  using Key = std::tuple<int, std::string>;
+  std::map<Key, std::vector<Msg>> groups;
+
+  for (const auto &call : calls) {
+    if (call.tag == -1) { // partnerRank check removed — tag+comm is sufficient
+      continue;
+    }
+
+    bool isSend = call.functionName.find("send") != std::string::npos;
+    bool isRecv = call.functionName.find("recv") != std::string::npos;
+
+    if (!isSend && !isRecv) {
+      continue;
+    }
+
+    // Key key = {call.partnerRank, call.tag, call.communicator};
+    // groups[key].push_back({call, isSend});
+
+    Key key = {call.tag, call.communicator};
+    groups[key].push_back({call, isSend});
+  }
+
+  // for (const auto &[key, group] : groups) {
+
+  //   MPICallSite sendCall, recvCall;
+  //   bool hasSend = false, hasRecv = false;
+
+  //   for (const auto &msg : group) {
+  //     if (msg.isSend) {
+  //       sendCall = msg.call;
+  //       hasSend = true;
+  //     } else {
+  //       recvCall = msg.call;
+  //       hasRecv = true;
+  //     }
+  //   }
+
+  //   if (!hasSend || !hasRecv) {
+  //     errors.push_back({"SendRecvMismatch", "Missing matching send/recv
+  //     pair",
+  //         group[0].call.lineNumber});
+  //     continue;
+  //   }
+
+  //   // Count mismatch
+  //   if (sendCall.count != -1 && recvCall.count != -1 &&
+  //       sendCall.count != recvCall.count) {
+  //     errors.push_back({"SendRecvMismatch",
+  //         "Mismatch between send and receive counts", sendCall.lineNumber});
+  //   }
+
+  //   // Datatype mismatch
+  //   if (sendCall.datatype != recvCall.datatype) {
+  //     errors.push_back({"SendRecvMismatch",
+  //         "Mismatch between send and receive datatypes",
+  //         sendCall.lineNumber});
+  //   }
+  // }
+
+  for (const auto &[key, group] : groups) {
+    std::vector<MPICallSite> sends, recvs;
+    for (const auto &msg : group) {
+      if (msg.isSend)
+        sends.push_back(msg.call);
+      else
+        recvs.push_back(msg.call);
+    }
+
+    // Ambiguous — multiple sends or recvs on same tag+comm, can't pair
+    // statically
+    if (sends.size() > 1 || recvs.size() > 1)
+      continue;
+
+    if (sends.empty() || recvs.empty()) {
+      errors.push_back({"SendRecvMismatch", "Missing matching send/recv pair",
+          group[0].call.lineNumber});
+      continue;
+    }
+
+    const auto &sendCall = sends[0];
+    const auto &recvCall = recvs[0];
+
+    if (sendCall.count != -1 && recvCall.count != -1 &&
+        sendCall.count != recvCall.count) {
+      errors.push_back({"SendRecvMismatch",
+          "Mismatch between send and receive counts", sendCall.lineNumber});
+    }
+    if (sendCall.datatype != recvCall.datatype) {
+      errors.push_back({"SendRecvMismatch",
+          "Mismatch between send and receive datatypes", sendCall.lineNumber});
+    }
+  }
+}
+
+void RuleEngine::checkCollectiveReachability(
+    const std::vector<MPICallSite> &calls, std::vector<MPIError> &errors) {
+
+  for (const auto &call : calls) {
+    if (!call.isCollective)
+      continue;
+
+    // executionRank == -1 means unconditional = safe
+    if (call.executionRank == -1)
+      continue;
+
+    // If inside an if/else construct, checkCollectiveOrdering
+    // handles correctness — reachability is not violated
+    if (call.hasElseCoverage)
+      continue;
+
+    // 🔥 Only flag one-sided rank conditions (no else branch)
+    errors.push_back({"CollectiveMismatch",
+        "Collective call may not be executed by all ranks", call.lineNumber});
+  }
+}
+
+void RuleEngine::checkCollectiveOrdering(
+    const std::vector<MPICallSite> &calls, std::vector<MPIError> &errors) {
+
+  // rank → [(functionName, lineNumber)]
+  std::map<int, std::vector<std::pair<std::string, int>>> sequences;
+
+  for (const auto &call : calls) {
+    if (!call.isCollective)
+      continue;
+
+    if (call.executionRank == 0) { // only flag rank==0 as likely one-sided
+      errors.push_back({"CollectiveMismatch",
+          "Collective call may not be executed by all ranks", call.lineNumber});
+    }
+
+    int rank =
+        call.executionRank; // -1 = all ranks, >=0 = specific, -3 = sentinel
+    sequences[rank].push_back({call.functionName, call.lineNumber});
+  }
+
+  if (sequences.size() < 2)
+    return;
+
+  // 🔥 FIX: choose correct reference sequence
+  auto refIt = sequences.find(-1); // prefer unconditional
+
+  if (refIt == sequences.end()) {
+    refIt = sequences.begin(); // fallback
+  }
+
+  const auto &[refRank, base] = *refIt;
+
+  // Compare all sequences
+  for (const auto &[rank, seq] : sequences) {
+
+    // Skip reference and sentinel
+    if (rank == refRank || rank == -3)
+      continue;
+
+    // Compare sequence order
+    for (size_t i = 0; i < std::min(seq.size(), base.size()); i++) {
+      if (seq[i].first != base[i].first) {
+        errors.push_back({"CollectiveOrdering",
+            "Rank " + std::to_string(rank) + " calls " + seq[i].first +
+                " but rank " + std::to_string(refRank) + " calls " +
+                base[i].first,
+            seq[i].second});
+        break;
+      }
+    }
+
+    // Compare lengths
+    if (seq.size() != base.size()) {
+      errors.push_back({"CollectiveOrdering",
+          "Rank " + std::to_string(rank) + " has " +
+              std::to_string(seq.size()) + " collective(s) but rank " +
+              std::to_string(refRank) + " has " + std::to_string(base.size()),
+          seq.size() > base.size() ? seq.back().second : base.back().second});
+    }
+  }
+}
+
+void RuleEngine::checkDerivedLayout(
+    const MPICallSite &call, std::vector<MPIError> &errors) {
+
+  if (!call.isDerivedType) {
+    return;
+  }
+
+  // Check if MPI datatype matches field types
+  for (const auto &fieldType : call.derivedFieldTypes) {
+
+    if (fieldType == "real" &&
+        call.datatype.find("mpi_real") == std::string::npos) {
+
+      errors.push_back(
+          {"DerivedLayout", "Derived type field (REAL) mismatches MPI datatype",
+              call.lineNumber});
+      return;
+    }
+
+    if (fieldType == "integer" &&
+        call.datatype.find("mpi_integer") == std::string::npos) {
+
+      errors.push_back({"DerivedLayout",
+          "Derived type field (INTEGER) mismatches MPI datatype",
+          call.lineNumber});
+      return;
+    }
+
+    if (fieldType == "complex" &&
+        call.datatype.find("mpi_complex") == std::string::npos) {
+      errors.push_back({"DerivedLayout",
+          "Derived type field (COMPLEX) mismatches MPI datatype",
+          call.lineNumber});
+      return;
+    }
+    if (fieldType == "character" &&
+        call.datatype.find("mpi_character") == std::string::npos) {
+      errors.push_back({"DerivedLayout",
+          "Derived type field (CHARACTER) mismatches MPI datatype",
+          call.lineNumber});
+      return;
+    }
+  }
+}
