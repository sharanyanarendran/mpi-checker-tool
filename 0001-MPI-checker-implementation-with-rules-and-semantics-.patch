+void RuleEngine::checkMixedCollectiveP2P(
+    const std::vector<MPICallSite> &calls, std::vector<MPIError> &errors) {
+
+  std::map<int, std::vector<const MPICallSite *>> constructGroups;
+  for (const auto &call : calls) {
+    if (call.ifConstructId != 0) {
+      constructGroups[call.ifConstructId].push_back(&call);
+    }
+  }
+
+  for (const auto &[id, group] : constructGroups) {
+    std::vector<const MPICallSite *> ifBranch, elseBranch;
+    for (const auto *call : group) {
+      if (call->executionRank >= 0 && call->hasElseCoverage) {
+        ifBranch.push_back(call);
+      } else if (call->executionRank == -4) {
+        elseBranch.push_back(call);
+      }
+    }
+
+    if (ifBranch.empty() || elseBranch.empty()) {
+      continue;
+    }
+
+    bool ifHasCollective = false, ifHasP2P = false;
+    bool elseHasCollective = false, elseHasP2P = false;
+
+    for (const auto *c : ifBranch) {
+      if (c->isCollective) {
+        ifHasCollective = true;
+      } else {
+        ifHasP2P = true;
+      }
+    }
+    for (const auto *c : elseBranch) {
+      if (c->isCollective) {
+        elseHasCollective = true;
+      } else {
+        elseHasP2P = true;
+      }
+    }
+
+    if (ifHasCollective && elseHasP2P && !elseHasCollective) {
+      for (const auto *c : elseBranch) {
+        if (!c->isCollective) {
+          errors.push_back({"MixedCollectiveP2P",
+              "if-branch uses collective but else-branch uses "
+              "point-to-point — potential deadlock",
+              c->lineNumber});
+          break;
+        }
+      }
+    }
+
+    if (elseHasCollective && ifHasP2P && !ifHasCollective) {
+      for (const auto *c : ifBranch) {
+        if (!c->isCollective) {
+          errors.push_back({"MixedCollectiveP2P",
+              "else-branch uses collective but if-branch uses "
+              "point-to-point — potential deadlock",
+              c->lineNumber});
+          break;
+        }
+      }
+    }
+  }
+}
+
+void RuleEngine::checkLoopCollective(
+    const std::vector<MPICallSite> &calls, std::vector<MPIError> &errors) {
+
+  for (const auto &call : calls) {
+
+    if (!call.isCollective)
+      continue;
+
+    if (!call.isInsideLoop)
+      continue;
+
+    if (call.executionRank != -1 && call.executionRank != -4) {
+
+      // Reachability already covers one-sided collectives
+      if (!call.hasElseCoverage)
+        continue;
+
+      errors.push_back({"LoopCollective",
+          "Collective call inside loop with rank condition — "
+          "iteration counts may differ across ranks",
+          call.lineNumber});
+
+    } else if (call.executionRank == -1 && call.loopDepth > 1) {
+
+      errors.push_back({"LoopCollective",
+          "Collective call inside nested loop — ensure all ranks "
+          "execute identical iteration counts",
+          call.lineNumber});
+    }
+  }
+}
+
+void RuleEngine::checkCrossConstructCommunicator(
+    const std::vector<MPICallSite> &calls, std::vector<MPIError> &errors) {
+
+  std::map<std::string, std::map<std::string, int>> funcCommToLine;
+
+  for (const auto &call : calls) {
+
+    llvm::errs() << "COMM DEBUG: " << call.functionName
+                 << " line=" << call.lineNumber
+                 << " rank=" << call.executionRank
+                 << " comm=" << call.communicator
+                 << " hasElse=" << call.hasElseCoverage << "\n";
+
+    if (!call.isCollective) {
+      continue;
+    }
+
+    if (call.communicator.empty()) {
+      continue;
+    }
+
+    // only rank-specific collectives
+    if (call.executionRank < 0) {
+      continue;
+    }
+
+    // IF/ELSE handled elsewhere
+    if (call.hasElseCoverage) {
+      continue;
+    }
+
+    // optional loop filter
+    if (call.isInsideLoop) {
+      continue;
+    }
+
+    auto &commMap = funcCommToLine[call.functionName];
+
+    // store first occurrence of communicator
+    if (!commMap.count(call.communicator)) {
+      commMap[call.communicator] = call.lineNumber;
+    }
+  }
+
+  // Detect communicator inconsistencies
+  for (const auto &[func, commMap] : funcCommToLine) {
+
+    if (commMap.size() <= 1) {
+      continue;
+    }
+
+    auto it1 = commMap.begin();
+    auto it2 = std::next(it1);
+
+    // Show earlier source location first
+    if (it1->second > it2->second) {
+      std::swap(it1, it2);
+    }
+
+    errors.push_back({"CommunicatorMismatch",
+        "Different ranks call " + func +
+            " on different communicators: " + it1->first + " (line " +
+            std::to_string(it1->second) + ") vs " + it2->first,
+        it2->second});
+  }
+}
+
+void RuleEngine::checkInterProceduralCalls(
+    const std::vector<MPICallSite> &calls, std::vector<MPIError> &errors) {
+
+  for (const auto &call : calls) {
+    if (call.isPotentialWrapper) {
+      errors.push_back({"InterProcedural",
+          "Possible MPI wrapper '" + call.functionName + "' passes buffer '" +
+              call.bufferName +
+              "' — inter-procedural analysis not supported, "
+              "verify MPI usage inside callee",
+          call.lineNumber});
+    }
+  }
+}
