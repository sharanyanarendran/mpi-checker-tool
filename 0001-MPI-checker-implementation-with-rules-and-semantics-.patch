+    }
+    std::cout << "\n";
+  }
+  std::cout << "]\n";
+}
+
+int MPICallVisitor::extractRank(const std::string &cond) {
+  for (int i = 0; i < 8; i++) { // support ranks 0–7 (enough)
+    std::string val = std::to_string(i);
+
+    if (cond.find("== " + val) != std::string::npos ||
+        cond.find(".eq." + val) != std::string::npos) {
+      return i;
+    }
+  }
+
+  // Negation / inequality: rank /= N, rank .ne. N, rank > N, rank < N
+  // We can't determine the exact rank, but it IS rank-conditioned.
+  // Return -3 as sentinel: "rank-conditioned, specific rank unknown"
+  if (cond.find("/=") != std::string::npos ||
+      cond.find(".ne.") != std::string::npos ||
+      cond.find(">") != std::string::npos ||
+      cond.find("<") != std::string::npos) {
+    return -3;
+  }
+  return -2;
+}
+
+std::string MPICallVisitor::extractFullCall(int lineNumber) {
+  if (!fileLines || lineNumber <= 0 ||
+      lineNumber > static_cast<int>(fileLines->size())) {
+    return "";
+  }
+
+  std::string result;
+  int openParens = 0;
+  bool started = false;
+
+  for (int i = lineNumber - 1; i < static_cast<int>(fileLines->size()); i++) {
+    std::string line = (*fileLines)[i];
+
+    // 🔹 REMOVE continuation '&'
+    line.erase(std::remove(line.begin(), line.end(), '&'), line.end());
+
+    // 🔹 TRIM each line
+    line = this->trim(line);
+
+    // 🔹 APPEND
+    if (!result.empty()) {
+      result += " ";
+    }
+    result += line;
+
+    // 🔹 TRACK parentheses
+    for (char c : line) {
+      if (c == '(') {
+        openParens++;
+        started = true;
+      } else if (c == ')') {
+        openParens--;
+      }
+    }
+
+    // 🔹 STOP when balanced
+    if (started && openParens == 0) {
+      break;
+    }
+  }
+
+  // 🔹 FINAL CLEANUP (WHOLE STRING)
+  result = this->trim(result);
+
+  return result;
+}
