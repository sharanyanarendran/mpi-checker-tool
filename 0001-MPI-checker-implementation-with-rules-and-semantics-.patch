++// ── Rank-if tracking ───────────────────────────────────────────────────────
++bool MPICallVisitor::Pre(const parser::IfConstruct &ifNode) {
++  const auto &ifThenStmt =
++      std::get<parser::Statement<parser::IfThenStmt>>(ifNode.t);
++  std::string cond = this->toLower(ifThenStmt.source.ToString());
++
++  if (isRankCondition(cond)) {
++    rankContextStack.push_back(this->currentRankContext);
++    rankIfHasElse.push_back(false); // assume no else until we see one
++
++    int r = extractRank(cond);
++    if (r != -2) {
++      this->currentRankContext = r;
++    }
++    ++this->rankIfDepth;
++  }
++  return true;
++}
++
++bool MPICallVisitor::Pre(const parser::IfConstruct::ElseBlock &) {
++  // Mark that the current rank-if HAS an else block
++  if (!rankIfHasElse.empty()) {
++    rankIfHasElse.back() = true;
++  }
++  // Inside else block: set rank context to -2 (else branch sentinel)
++  // -2 means "else branch of a rank-conditioned if"
++  this->currentRankContext = -2;
++  this->insideElseBlock = true;
++  return true;
++}
++
++bool MPICallVisitor::Pre(const parser::IfConstruct::ElseIfBlock &block) {
++  const auto &stmt = std::get<parser::Statement<parser::ElseIfStmt>>(block.t);
++  std::string cond = this->toLower(stmt.source.ToString());
++
++  // ElseIf also counts as "has else" for coverage purposes
++  if (!rankIfHasElse.empty()) {
++    rankIfHasElse.back() = true;
++  }
++
++  if (isRankCondition(cond)) {
++    int r = extractRank(cond);
++    this->currentRankContext = (r != -2) ? r : -3;
++  } else {
++    this->currentRankContext = -1; // non-rank else-if = all ranks
++  }
++  return true;
++}
++
++void MPICallVisitor::Post(const parser::IfConstruct &ifNode) {
++  const auto &ifThenStmt =
++      std::get<parser::Statement<parser::IfThenStmt>>(ifNode.t);
++  std::string cond = this->toLower(ifThenStmt.source.ToString());
++
++  if (isRankCondition(cond)) {
++    // Pop the else tracking
++    if (!rankIfHasElse.empty()) {
++      rankIfHasElse.pop_back();
++    }
++    if (!rankContextStack.empty()) {
++      this->currentRankContext = rankContextStack.back();
++      rankContextStack.pop_back();
++    } else {
++      this->currentRankContext = -1;
++    }
++    --this->rankIfDepth;
++    this->insideElseBlock = false;
++  }
++}
++
++int MPICallVisitor::safeParseInt(const std::string &s) {
++  int value = 0;
++  bool started = false;
++  for (char c : s) {
++    if (isspace(c)) {
++      continue;
++    }
++    if (!isdigit(c)) {
++      return -1;
++    }
++    started = true;
++    value = value * 10 + (c - '0');
++  }
++  return started ? value : -1;
++}
